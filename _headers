# Règles d'en-têtes HTTP lues automatiquement par Cloudflare Pages.
# Ne pas renommer ce fichier : il doit rester « _headers » à la racine du site.

# Photos : cache long (elles changent rarement)
/assets/img/*
  Cache-Control: public, max-age=2592000

# Code : cache court, pour que l'ajout d'un produit ou d'un prix
# soit visible par les visiteurs en quelques minutes.
/assets/js/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=300, must-revalidate

# Sécurité, appliquée à toutes les pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
